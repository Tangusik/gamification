# Окружение ДЕПЛОЯ. Образец для docker-compose.yml — НЕ для
# docker-compose.dev.yml, там свой deploy/.env.example (П3).
#
#   cp deploy/.env.production.example deploy/.env.production
#   # заполнить секреты и ACME_EMAIL (CADDY_DOMAIN уже указан), затем:
#   docker compose --env-file deploy/.env.production -f docker-compose.yml up -d --build
#
# Секретов в этом файле нет и быть не должно: он попадает в репозиторий
# (.gitignore пускает только .env.example и этот файл, см. П2).
# deploy/.env.production — реальный файл с секретами — игнорируется.
#
# Отличия от deploy/.env.example (dev-образец), которые и были причиной
# П3: здесь USERS_ENVIRONMENT=production, WEB_PORT не используется
# вовсе (web порт наружу не публикует, П12 — наружу смотрит только
# caddy на 80/443), *_IMAGE_TAG без dev-значения по умолчанию и
# добавлены CADDY_DOMAIN/ACME_EMAIL.

# --- Postgres ---------------------------------------------------------
# Пароль обязателен: без него compose откажется собирать конфигурацию.
# Спецсимволы (@ : / ?) ломают *_DATABASE_URL, собираемый в compose из
# этих значений, — использовать [A-Za-z0-9_-].
POSTGRES_USER=users
POSTGRES_PASSWORD=
POSTGRES_DB=users
# POSTGRES_PORT здесь не используется: порт БД в docker-compose.yml не
# публикуется вовсе, только в docker-compose.dev.yml.

# --- Сервис users -------------------------------------------------------
# production запрещает кодом сервиса хранилище memory (в отличие от
# local/test), тем самым отсекает случайный запуск без реальной БД.
USERS_ENVIRONMENT=production
USERS_LOG_LEVEL=INFO
USERS_IMAGE_TAG=
USERS_JWT_ALGORITHM=RS256
USERS_JWT_LIFETIME_SECONDS=900

# Опционально: при пустых значениях сид владельца не выполняется.
# Пароль — минимум 8 символов.
USERS_BOOTSTRAP_ADMIN_EMAIL=
USERS_BOOTSTRAP_ADMIN_PASSWORD=

# --- Сервис gamification -------------------------------------------------
# Пароли ОБЯЗАНЫ различаться (L1): при совпадении пароль контейнера
# приложения (gamification_app) открыл бы вход под ролью-владельцем
# таблиц, и RLS перестало бы действовать на приложение. Init-скрипт
# сверяет их и отказывает при совпадении. Спецсимволы — как у
# POSTGRES_PASSWORD, использовать [A-Za-z0-9_-].
GAMIFICATION_DB_PASSWORD=
GAMIFICATION_APP_DB_PASSWORD=
GAMIFICATION_ENVIRONMENT=production
GAMIFICATION_LOG_LEVEL=INFO
GAMIFICATION_IMAGE_TAG=

# --- Служебный секрет gamification <-> users ------------------------------
# Одно значение на обе стороны (C1). Не короче 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_GAMIFICATION_SECRET=

# --- Служебный секрет users <-> gamification (план 10-refresh, У7) --------
# Обратное направление — отдельный секрет, не общий с
# INTERNAL_GAMIFICATION_SECRET (У7). Тот же способ генерации.
INTERNAL_USERS_SECRET=
INTERNAL_USERS_SECRET_PREVIOUS=

# --- Ключи подписи --------------------------------------------------------
# PEM целиком, вместе со строками BEGIN/END, в двойных кавычках —
# значение многострочное. Прод обязан использовать СВОЮ пару, не ту,
# что в deploy/.env.example для разработки. Команда генерации —
# services/users/README.md, раздел «Ключи подписи».
USERS_JWT_PRIVATE_KEY=
USERS_JWT_PUBLIC_KEY=

# --- Caddy: TLS и Let's Encrypt (В1 = H3) ---------------------------------
# Домен, на который смотрит сертификат, и почта, на которую Let's
# Encrypt шлёт уведомления об истечении и проблемах продления. Оба
# обязательны (docker-compose.yml, ":?") — без них compose откажется
# собирать конфигурацию, а не поднимет caddy без TLS.
#
# Домен владелец назвал — вписан ниже, он не секрет. ACME_EMAIL —
# контактный адрес владельца для Let's Encrypt: вписывается вручную
# только в deploy/.env.production при деплое, в репозиторий (в т.ч. в
# этот образец) не коммитится.
CADDY_DOMAIN=your-gamification.ru
ACME_EMAIL=
