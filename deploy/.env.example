# Переменные окружения для docker compose.
#
# Скопировать в КОРЕНЬ репозитория под именем .env — compose читает
# только его (файл в .gitignore):
#
#   cp deploy/.env.example .env
#
# Реальные секреты в репозиторий не попадают: здесь значения-образцы
# для локальной разработки, для деплоя все пароли и ключи задаются
# заново.
#
# Корневой .env — файл окружения РАЗРАБОТКИ. Деплойный
# docker-compose.yml запускается только с явным --env-file (например
# deploy/.env.production), иначе он молча возьмёт dev-пароль, ключи
# разработчика и USERS_ENVIRONMENT=local.

# --- Postgres -------------------------------------------------------
# Пользователь и база сервиса users. Пароль обязателен: без него
# compose откажется собирать конфигурацию, а не поднимет базу с
# предсказуемым паролем.
# Спецсимволы в пароле (@ : / ?) ломают USERS_DATABASE_URL — он
# собирается в compose из этих значений. Использовать [A-Za-z0-9_-].
POSTGRES_USER=users
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=users
# Порт на хосте; публикуется только в docker-compose.dev.yml.
POSTGRES_PORT=5432

# --- pgAdmin (только dev) -------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local
PGADMIN_PORT=5050

# --- Сервис users ---------------------------------------------------
# local | test | production. В production реализация хранилища
# memory запрещена кодом сервиса.
USERS_ENVIRONMENT=local
USERS_LOG_LEVEL=INFO
USERS_PORT=8000
USERS_IMAGE_TAG=dev
USERS_JWT_ALGORITHM=RS256
USERS_JWT_LIFETIME_SECONDS=900

# Опционально: при пустых значениях сид владельца не выполняется.
# Пароль — минимум 8 символов.
USERS_BOOTSTRAP_ADMIN_EMAIL=
USERS_BOOTSTRAP_ADMIN_PASSWORD=

# --- Сервис gamification --------------------------------------------
# Пользователь и база сервиса gamification (I1): отдельная роль и база
# в том же кластере PostgreSQL, без доступа к базе users. Пароль
# обязателен по тем же причинам, что POSTGRES_PASSWORD, и подчиняется
# тем же ограничениям на спецсимволы (собирается в DSN в compose):
# использовать [A-Za-z0-9_-].
#
# GAMIFICATION_DB_PASSWORD и GAMIFICATION_APP_DB_PASSWORD обязаны
# различаться (L1): если задать одинаковое значение, пароль из
# контейнера приложения (роль gamification_app) откроет вход под
# ролью-владельцем таблиц gamification, и RLS перестанет действовать
# на приложение. Init-скрипт сверяет их и отказывает при совпадении.
GAMIFICATION_DB_PASSWORD=change-me-local-owner
# Пароль роли приложения gamification_app (У1): без прав владельца
# схемы и таблиц, без BYPASSRLS — под ней ходит сам сервис, под ролью
# gamification (выше) идут только миграции. Те же ограничения на
# спецсимволы, что у GAMIFICATION_DB_PASSWORD: использовать
# [A-Za-z0-9_-]. Значение обязано отличаться от GAMIFICATION_DB_PASSWORD
# (см. комментарий выше).
GAMIFICATION_APP_DB_PASSWORD=change-me-local-app
GAMIFICATION_ENVIRONMENT=local
GAMIFICATION_LOG_LEVEL=INFO
# Порт на хосте; публикуется только в docker-compose.dev.yml.
GAMIFICATION_PORT=8001
GAMIFICATION_IMAGE_TAG=dev

# --- Служебный секрет gamification ↔ users ---------------------------
# Одно значение на обе стороны: users читает его как
# USERS_INTERNAL_GAMIFICATION_SECRET, gamification — как
# GAMIFICATION_USERS_SERVICE_SECRET (C1). Не короче 32 символов.
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_GAMIFICATION_SECRET=

# --- Служебный секрет users ↔ gamification (план 10-refresh, У7) -----
# Обратное направление: users читает его как
# USERS_GAMIFICATION_SERVICE_SECRET, gamification — как
# GAMIFICATION_INTERNAL_USERS_SECRET. Отдельный от
# INTERNAL_GAMIFICATION_SECRET намеренно — общий секрет на оба
# направления позволил бы утечке одного выдать себя за любой из
# сервисов. Не короче 32 символов, тот же способ генерации.
INTERNAL_USERS_SECRET=
# Второе значение на время ротации: gamification принимает оба, пока
# users не переведена на новый. Пусто — ротация не идёт.
INTERNAL_USERS_SECRET_PREVIOUS=

# Опционально — умолчания в docker-compose уже совпадают с решением
# владельца (вопросы 3 и 4 плана 10-refresh), менять нужно редко.
# USERS_REFRESH_REUSE_GRACE_SECONDS=30
# USERS_REFRESH_WEB_IDLE_DAYS=7
# USERS_REFRESH_WEB_ABSOLUTE_DAYS=30
# USERS_REFRESH_MOBILE_IDLE_DAYS=30
# USERS_REFRESH_MOBILE_ABSOLUTE_DAYS=90
# USERS_REFRESH_COOKIE_SECURE=true

# --- Сервис web (фронтенд и шлюз) ------------------------------------
# Порт на хосте. В разработке 8080 (публикуется на 127.0.0.1), в
# деплое сюда ставится 80 — это единственный публикуемый порт стека.
WEB_PORT=8080
WEB_IMAGE_TAG=dev

# --- Ключи подписи --------------------------------------------------
# PEM целиком, вместе со строками BEGIN/END. Значение многострочное,
# поэтому обязано быть в двойных кавычках — так его читают и compose,
# и сервис. Команда генерации пары — в services/users/README.md,
# раздел «Ключи подписи».
#
# USERS_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...
# -----END PRIVATE KEY-----"
#
# USERS_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# -----END PUBLIC KEY-----"
#
# В k8s оба значения приходят из Secret, файл .env там не используется.
USERS_JWT_PRIVATE_KEY=
USERS_JWT_PUBLIC_KEY=
