# Настройки сервиса gamification. Все переменные имеют префикс GAMIFICATION_.

GAMIFICATION_APP_NAME=gamification
GAMIFICATION_ENVIRONMENT=local
GAMIFICATION_LOG_LEVEL=INFO

# Публичный префикс, под которым сервис виден снаружи через nginx.
# Маршруты им не префиксуются: значение нужно только для того, чтобы
# OpenAPI и /docs показывали адреса, по которым ходит клиент.
# Пусто при прямом обращении к порту сервиса. За шлюзом: /api/v1
GAMIFICATION_ROOT_PATH=

# Публичный ключ проверки токенов users (J1) — то же значение, что
# USERS_JWT_PUBLIC_KEY у сервиса users. Приватного ключа здесь нет и
# быть не может: gamification только проверяет токены, но не выпускает
# их сама.
#
# Значение — PEM целиком, вместе со строками BEGIN/END, в кавычках,
# как у USERS_JWT_PUBLIC_KEY в services/users/.env.example.
GAMIFICATION_JWT_PUBLIC_KEY=
GAMIFICATION_JWT_ALGORITHM=RS256
# Аудитория токена. Общая строка-контракт со всеми сервисами; расхождение
# с users даёт молчаливый 401 на всём сервисе (риск 8).
GAMIFICATION_JWT_AUDIENCE=["fastapi-users:auth"]

# Реализация хранилища: postgres (по умолчанию) или memory.
# memory разрешён только при GAMIFICATION_ENVIRONMENT из local/test.
GAMIFICATION_STORAGE_BACKEND=postgres

# DSN своей базы (I1): своя база gamification, своя роль, без доступа
# к базе users. Формат: postgresql+asyncpg://user:password@host:port/dbname
GAMIFICATION_DATABASE_URL=

# Адрес Redis users для чтения denylist отозванных токенов (K1).
# Формат: redis://host:port/db
# Только чтение, fail-open, таймаут 1 с. Недоступность отражается в
# /health/ready, но не отвергает запросы. Пусто допустимо только при
# GAMIFICATION_ENVIRONMENT из local/test.
GAMIFICATION_REDIS_URL=

# Внутренний адрес сервиса users для переключения учреждения (раздел 4).
GAMIFICATION_USERS_INTERNAL_URL=http://users:8000

# Служебный секрет для заголовка X-Service-Secret при вызове
# POST /internal/tokens/institution-context (C1). Не короче 32 символов
# вне local/test — иначе старт роняет InsecureSettingError.
GAMIFICATION_USERS_SERVICE_SECRET=
