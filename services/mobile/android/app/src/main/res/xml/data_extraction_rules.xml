<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) заменил старый fullBackupContent на этот формат.
     allowBackup="false" в манифесте выключает только облачный автобэкап
     (cloud-backup); прямой перенос на новое устройство (device-transfer,
     Android 12+) им не отключается и работает уже сейчас — поэтому эти
     правила исключают хранилище токенов из обоих путей уже на текущем этапе,
     а не «на случай будущего включения» (Н7/К11/Р4 ревью `10-refresh.md`). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
