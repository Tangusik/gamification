# Что не должно попасть в контекст сборки образа web.
#
# Отдельный файл обязателен: контекст сборки этого образа —
# services/web, а не корень репозитория, поэтому корневой
# .dockerignore здесь не применяется вообще. Главная строка —
# node_modules: в корневом файле её нет, и без этой копии в демон
# уехали бы сотни мегабайт зависимостей хоста (собранных под Windows и
# в linux-образе всё равно нерабочих).
node_modules
**/node_modules

# Артефакты сборки хоста: dist собирается ВНУТРИ образа, копия с хоста
# только испортила бы слой.
dist
dist-ssr
build

# Секреты и локальные переопределения окружения.
.env
*.env
!.env.example
# .env.production и подобные (L4) — как в .dockerignore, не ловятся
# паттернами выше.
**/.env.*
!**/.env.example
*.local

# Кеши инструментов
.vite
.cache
.oxlint_cache
*.tsbuildinfo

# Служебное
.git
.gitignore
.idea
.vscode
.DS_Store
*.log

# Конфиг nginx не участвует в стадии сборки фронта, но нужен на стадии
# раздачи — поэтому НЕ исключается.
