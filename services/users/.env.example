# Настройки сервиса users. Все переменные имеют префикс USERS_.

USERS_APP_NAME=users
USERS_ENVIRONMENT=local
USERS_LOG_LEVEL=INFO

# Публичный префикс, под которым сервис виден снаружи через nginx.
# Маршруты им не префиксуются: значение нужно только для того, чтобы
# OpenAPI и /docs показывали адреса, по которым ходит клиент.
# Пусто при прямом обращении к порту сервиса. За шлюзом: /api/v1
USERS_ROOT_PATH=

# Пара ключей подписи. Обе переменные обязательны, без них сервис не
# стартует. Приватным ключом токены подписываются и он не должен покидать
# этот сервис; публичный раздаётся остальным сервисам для проверки.
#
# Значение — PEM целиком, вместе со строками BEGIN/END. В .env оно
# переносится по строкам и потому обязано быть в кавычках:
#
#   USERS_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...
#   -----END PRIVATE KEY-----"
#
# Сгенерировать пару — команда в README, раздел «Ключи подписи».
# В k8s значения приходят из Secret, файл .env там не используется.
USERS_JWT_PRIVATE_KEY=
USERS_JWT_PUBLIC_KEY=
USERS_JWT_ALGORITHM=RS256
# Строго больше нуля: при 0 выдавался бы токен без срока действия.
# 900 секунд — короткий срок компенсирует отсутствие мгновенного отзыва.
USERS_JWT_LIFETIME_SECONDS=900

# Опционально; при пустых значениях сид не выполняется.
# Пароль администратора — минимум 8 символов, как и при регистрации.
USERS_BOOTSTRAP_ADMIN_EMAIL=
USERS_BOOTSTRAP_ADMIN_PASSWORD=

# Реализация хранилища: postgres (по умолчанию) или memory.
# Умолчание намеренно postgres: забытая переменная не должна тихо дать
# хранилище в памяти. Значение memory разрешено только при
# USERS_ENVIRONMENT из local/test — иначе сервис не стартует, потому что
# в остальных окружениях это молчаливая потеря данных при рестарте.
USERS_STORAGE_BACKEND=postgres

# DSN базы. Обязателен при USERS_STORAGE_BACKEND=postgres: без него
# сервис не стартует. Драйвер именно asyncpg — движок асинхронный.
# Формат: postgresql+asyncpg://user:password@host:port/dbname
# Пароль в значении есть, поэтому переменная не логируется и в тексте
# ошибок не появляется. В k8s значение приходит из Secret.
USERS_DATABASE_URL=

# Адрес Redis для denylist отозванных токенов.
# Формат: redis://host:port/db
# При недоступном Redis проверка отзыва работает fail-open: запрос не
# отклоняется, отзыв временно не действует.
USERS_REDIS_URL=

# Служебный секрет вызывающего на внутренний выпуск токена в контексте
# учреждения (POST /internal/tokens/institution-context). Единственный
# ожидаемый вызывающий — сервис gamification. Минимум 32 символа вне
# local/test; в local/test пустое значение допустимо для старта, но
# тогда любой внутренний вызов отвергается (SERVICE_AUTH_FAILED).
USERS_INTERNAL_GAMIFICATION_SECRET=
# Второе значение на время ротации секрета: users принимает оба, пока
# gamification не переведена на новый. Пусто — ротация не идёт.
USERS_INTERNAL_GAMIFICATION_SECRET_PREVIOUS=
